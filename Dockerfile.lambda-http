# Dockerfile.lambda-http
# ---- Build stage ----
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

# ---- Runtime stage (AWS Lambda Node.js 20 — Amazon Linux 2023) ----
FROM public.ecr.aws/lambda/nodejs:20
WORKDIR /var/task

# Install Python 3 and OR-Tools (only package solver_cli.py needs in --cli mode)
RUN dnf install -y python3 python3-pip && \
    pip3 install --no-cache-dir ortools && \
    dnf clean all

# Copy Node.js build artifacts
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Copy Python solver script
COPY --from=builder /app/src/core/solver/solver_cli.py ./solver_cli.py

# Point solver adapter at the correct Python and script path inside the image
ENV SOLVER_PYTHON=python3
ENV SOLVER_CLI_PATH=/var/task/solver_cli.py

CMD ["dist/http-lambda.handler"]
