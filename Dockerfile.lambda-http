# Dockerfile.lambda-http
# ---- Build stage ----
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

# ---- Runtime stage (AWS Lambda Node.js 20 — Amazon Linux 2023) ----
FROM public.ecr.aws/lambda/nodejs:20
WORKDIR /var/task

# Install Python 3.11 and OR-Tools.
# python3 (3.9) on AL2023 conflicts with the Lambda image's OpenSSL 3.4.0.
RUN dnf install -y python3.11 && \
    python3.11 -m ensurepip --upgrade && \
    python3.11 -m pip install --no-cache-dir ortools && \
    dnf clean all

# Copy Node.js build artifacts
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Copy Python solver script (Lambda version with alias resolution)
COPY --from=builder /app/src/aws/solver_lambda/solver_cli.py ./solver_cli.py

# Point solver adapter at the correct Python and script path inside the image
ENV SOLVER_PYTHON=python3.11
ENV SOLVER_CLI_PATH=/var/task/solver_cli.py

CMD ["dist/http-lambda.handler"]
