# ─────────────────────────────────────────────────────────────────────────────
# MayWin Core Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=maywin
DB_SCHEMA=maywin_db

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT signing secret — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Skip 2FA OTP entirely — returns JWT directly from /auth/login (dev only, never in production)
AUTH_DISABLE_OTP=false

# BFF → backend service token. Staff endpoints check Authorization: Bearer <CORE_API_TOKEN>.
# Generate a random string. Must match the token the BFF sends.
CORE_API_TOKEN=change-me

# ── Python solver ────────────────────────────────────────────────────────────
# Python executable name. Use "py" on Windows, "python3" on macOS/Linux.
SOLVER_PYTHON=python3
SOLVER_CLI_PATH=src/core/solver/solver_cli.py

# Automatically persist solver output to the schedule on job completion (default: false)
AUTO_PERSIST_SCHEDULES=false

# ── SMTP (OTP + welcome emails) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MayWin <your-email@gmail.com>

# ── Frontend URL (CORS, email links) ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── LINE Chatbot (optional — WebhookModule) ──────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Gemini AI for NLU (LINE chatbot message interpretation)
GEMINI_API_KEY=

# URL shown in LINE chatbot PDPA consent notice (PDPA §24 — required if LINE chatbot is enabled)
MAYWIN_PRIVACY_URL=https://your-domain.com/privacy

# Directory for local audit log CSV (defaults to /tmp when unset)
AUDIT_LOG_DIR=/tmp

# ── AWS (optional — S3 artifacts + Step Functions orchestration) ──────────────
AWS_REGION=ap-southeast-1

# S3 bucket for solver/schedule artifacts. Leave empty to disable S3 storage.
MAYWIN_ARTIFACTS_BUCKET=
MAYWIN_ARTIFACTS_PREFIX=maywin-artifacts/core

# Orchestration mode: LOCAL_RUNNER (default) or STEP_FUNCTIONS
# MAYWIN_ORCHESTRATION_MODE is the legacy alias; either works.
ORCHESTRATION_MODE=LOCAL_RUNNER

# Step Functions state machine ARN — required when ORCHESTRATION_MODE=STEP_FUNCTIONS
# MAYWIN_SFN_ARN is the legacy alias; either works.
SCHEDULE_WORKFLOW_ARN=

# When true, solver jobs are queued through the local runner even in Lambda (default: false)
ENQUEUE_LOCAL_RUNNER=false
