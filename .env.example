# ─────────────────────────────────────────────────────────────────────────────
# MayWin Core Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=maywin
DB_SCHEMA=maywin_db

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT signing secret — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# ── Python solver ────────────────────────────────────────────────────────────
# Python executable name. Use "py" on Windows, "python3" on macOS/Linux.
SOLVER_PYTHON=python3
SOLVER_CLI_PATH=src/core/solver/solver_cli.py

# ── SMTP (OTP + welcome emails) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MayWin <your-email@gmail.com>

# ── Frontend URL (CORS, email links) ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── LINE Chatbot (optional — WebhookModule) ───────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Gemini AI for NLU (LINE chatbot message interpretation)
GEMINI_API_KEY=

# Directory for local audit log CSV (defaults to /tmp when unset)
AUDIT_LOG_DIR=/tmp

# ── AWS (optional — S3 artifacts + Step Functions orchestration) ──────────────
AWS_REGION=ap-southeast-1

# S3 bucket for solver/schedule artifacts. Leave empty to disable S3 storage.
MAYWIN_ARTIFACTS_BUCKET=
MAYWIN_ARTIFACTS_PREFIX=maywin-artifacts/core

# Orchestration mode: LOCAL_RUNNER (default) or STEP_FUNCTIONS
ORCHESTRATION_MODE=LOCAL_RUNNER

# Step Functions state machine ARN — required when ORCHESTRATION_MODE=STEP_FUNCTIONS
SCHEDULE_WORKFLOW_ARN=
